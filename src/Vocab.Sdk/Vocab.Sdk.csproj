<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Vocab.Sdk</PackageId>
    <Title>Vocab SDK</Title>
    <Description>Core client for vo.cab network apps: sign-in token exchange and refresh against auth.vo.cab, and the network API (who am I, profile, external ids, linked profiles) over https://{network}.api.vo.cab. Platform packages (Vocab.Sdk.AspNetCore, Vocab.Sdk.Maui) build on this one.</Description>
    <RootNamespace>Vocab.Sdk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
