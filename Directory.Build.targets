<Project>

  <!--
    Source-graph switch for building and testing.

    The committed edge from Vocab.Sdk.AspNetCore to Vocab.Sdk is a PackageReference floating to the newest
    published Vocab.Sdk, and it must stay that way: `dotnet pack` then records a dependency on a version
    that exists on nuget.org. A ProjectReference would make pack record the sibling's freshly evaluated
    time stamp, a version that is never published, and every consumer's restore would fail.

    The cost is that a plain build compiles Vocab.Sdk.AspNetCore (and so its tests and the sample) against
    the LAST PUBLISHED Vocab.Sdk, not the working tree. To build and test the whole graph from source:

        dotnet build -c Release -p:UseProjectReferences=true
        dotnet test  -c Release -p:UseProjectReferences=true

    With the property unset nothing here applies. Never pass it to `dotnet pack`; the target below refuses.
  -->
  <ItemGroup Condition=" '$(UseProjectReferences)' == 'true' ">
    <!-- Probe item: survives only if this project does NOT reference Vocab.Sdk as a package. -->
    <_VocabAbsent_Vocab_Sdk Include="Vocab.Sdk" />
    <_VocabAbsent_Vocab_Sdk Remove="@(PackageReference)" />

    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Vocab.Sdk/Vocab.Sdk.csproj"
                      Condition=" '@(_VocabAbsent_Vocab_Sdk)' == '' " />
    <PackageReference Remove="Vocab.Sdk" />
  </ItemGroup>

  <Target Name="RefuseToPackFromProjectReferences" BeforeTargets="GenerateNuspec"
          Condition=" '$(UseProjectReferences)' == 'true' ">
    <Error Text="Do not pack with UseProjectReferences=true: the package would depend on a Vocab.Sdk version that is never published. Pack against the feed (see Directory.Build.targets)." />
  </Target>

</Project>
