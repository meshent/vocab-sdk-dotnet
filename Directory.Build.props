<Project>

  <!--
    Shared build settings for every project in this repository.

    Versioning is time based, the same scheme as the rest of vo.cab's packages, so a newer build always
    carries a higher version: Major.Minor are fixed here, Build is whole UTC days since 2020-01-01 and
    Revision is the half-second of that day (0..43199). Both halves derive from ONE UTC clock reading, so a
    build that straddles midnight can never stamp a lower version than an earlier one, and a developer
    machine in another time zone stamps the same number CI would. A build from any branch but main gets the
    branch name as its prerelease tag (`0.0.2479.1234-wip-feature`); main builds are release versions.
    CI passes the branch as /p:Branch. Never set VersionBuild or VersionRevision by hand to force a version.

    The packages version independently; the numbers carry no meaning beyond ordering. Vocab.Sdk.AspNetCore
    depends on Vocab.Sdk as a published package (VocabSdkPackageVersion, "*" by default), and the release
    workflow packs and publishes Vocab.Sdk before Vocab.Sdk.AspNetCore, pointing the dependency at that
    exact package, so the recorded dependency always names a version that is on nuget.org.

    Check an edit by evaluating, not by building:  dotnet msbuild src/Vocab.Sdk/Vocab.Sdk.csproj -getProperty:Version
  -->
  <PropertyGroup>
    <VersionMajor Condition=" '$(VersionMajor)' == '' ">0</VersionMajor>
    <VersionMinor Condition=" '$(VersionMinor)' == '' ">0</VersionMinor>
    <_EpochSeconds>$([System.Math]::Floor($([System.DateTime]::op_Subtraction($([System.DateTime]::get_UtcNow()),$([System.DateTime]::new(2020,1,1))).get_TotalSeconds())))</_EpochSeconds>
    <VersionBuild Condition=" '$(VersionBuild)' == '' ">$([System.Math]::Floor($([MSBuild]::Divide($(_EpochSeconds), 86400))))</VersionBuild>
    <VersionRevision Condition=" '$(VersionRevision)' == '' ">$([System.Math]::Floor($([MSBuild]::Divide($([MSBuild]::Modulo($(_EpochSeconds), 86400)), 2))))</VersionRevision>
    <VersionBranch Condition=" '$(Branch)' != '' and '$(Branch)' != 'main' ">$([System.String]::Copy('$(Branch)').Replace('/','-').Replace('\','-').Replace('.','-'))</VersionBranch>
    <VersionPrefix>$(VersionMajor).$(VersionMinor).$(VersionBuild).$(VersionRevision)</VersionPrefix>
    <VersionSuffix>$(VersionBranch)</VersionSuffix>
    <!-- The Vocab.Sdk version Vocab.Sdk.AspNetCore depends on: the newest published release unless CI names
         the exact package it packed a moment earlier (see release.yml). -->
    <VocabSdkPackageVersion Condition=" '$(VocabSdkPackageVersion)' == '' ">*</VocabSdkPackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Package metadata shared by the shipped packages (src/**). -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>true</IsPackable>
    <Authors>vo.cab</Authors>
    <Company>vo.cab</Company>
    <Product>Vocab SDK for .NET</Product>
    <Copyright>© vo.cab</Copyright>
    <PackageProjectUrl>https://developers.vo.cab</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meshent/vocab-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>vocab;vo.cab;sdk;oauth;openid-connect;network-app</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
